<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@(ViewBag.Title ?? "Ingreso") | Mesa de Ayuda INAMU</title>
    @Styles.Render("~/Content/css")
    <link href="~/Content/bootstrap.css" rel="stylesheet" />
    <link href="~/Content/animate.min.css" rel="stylesheet" />
    <link href="~/Content/light-bootstrap-dashboard.css" rel="stylesheet" />
    <link href="~/Content/pe-icon-7-stroke.css" rel="stylesheet" />
    <link href="~/Content/demo.css" rel="stylesheet" />
    <link href="~/Content/remodal-default-theme.css" rel="stylesheet" />
    <link href="~/Content/remodal.css" rel="stylesheet"/>
    <link href="~/Content/Site.css" rel="stylesheet" />
    @*<link href="~/Content/mdb.min.css" rel="stylesheet" />*@
    <link href="~/Content/font-awesome.min.css" rel="stylesheet" />
    <script src="~/Scripts/detect.js"></script>
    <script src="~/Scripts/jquery-1.10.2.min.js"></script>
    <script src="~/Scripts/bootstrap.min.js"></script>
    <script src="~/Scripts/widgets.js"></script>
    <script src="~/Scripts/parsley.js"></script>
    <script src="~/Scripts/es.js"></script>
    <script src="~/Scripts/remodal.min.js"></script>
    @*<script src="~/Scripts/mdb.min.js"></script>*@
    <script src="~/Scripts/notify.js"></script>
    <script src="~/Scripts/loadingoverlay.min.js"></script>
    <script src="~/Scripts/app-shell.js"></script>
    <!-- Bootstrap -->
    <!-- Bootstrap Material Design -->
    @*<link href="~/Content/bootstrap-material-design.min.css" rel="stylesheet" />
        <link href="~/Content/ripples.min.css" rel="stylesheet" />*@

</head>
<body class="login-body">
    <div id="networkStatus" class="network-status" role="status" aria-live="polite" hidden>
        <i class="fa fa-wifi" aria-hidden="true"></i>
        Sin conexión. Verifique su red antes de continuar.
    </div>
    <div id="globalLoader" class="global-loader" role="status" aria-live="polite" aria-hidden="true">
        <div class="global-loader__card">
            <span class="global-loader__spinner" aria-hidden="true"></span>
            <strong id="globalLoaderTitle">Validando información…</strong>
            <span id="globalLoaderMessage">Esto puede tomar unos segundos.</span>
            <small id="globalLoaderHint">Por favor, no cierre esta ventana.</small>
        </div>
    </div>
    <main class="container body-content login-shell">
        @RenderBody()
        @*<hr />*@
    </main>
    <footer class="login-footer">
        <small>&copy; @DateTime.Now.Year INAMU Costa Rica &middot; Todos los derechos reservados</small>
    </footer>

</body>
</html>
